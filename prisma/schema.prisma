// AI 古诗词文化探索平台 - Prisma Schema
// 映射 MySQL schema.sql 中的 8 张表 + users 表（鉴权用）

generator client {
  provider      = "prisma-client-js"
  // Vercel（Amazon Linux 2023）需要 rhel-openssl-3.0.x；native 供本机开发使用
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// 诗篇主表
model Poem {
  id             String  @id @db.Char(36)
  title          String  @db.VarChar(255)
  author         String  @db.VarChar(64)
  dynasty        String  @db.VarChar(16) @default("唐")
  paragraphs     Json
  paragraphsSimp Json?  @map("paragraphs_simp")
  tags           Json?
  sourceFile     String? @map("source_file") @db.VarChar(255)
  createdAt      DateTime @default(now()) @map("created_at")

  annotations Annotation?
  poemImagery  PoemImagery[]
  chunks       Chunk[]

  @@index([author], map: "idx_poems_author")
  @@index([dynasty], map: "idx_poems_dynasty")
  @@map("poems")
}

// 赏析表
model Annotation {
  poemId    String  @id @map("poem_id") @db.Char(36)
  fanyi     String? @db.MediumText
  shangxi   String? @db.MediumText
  zhushihui String? @db.MediumText
  source    String  @default("AI生成(GLM-4-Flash)") @db.VarChar(64)
  model     String? @db.VarChar(32)
  createdAt DateTime @default(now()) @map("created_at")

  poem Poem @relation(fields: [poemId], references: [id], onDelete: Cascade, map: "fk_annotations_poem")

  @@map("annotations")
}

// 诗人小传
model PoetBio {
  id        String   @id @db.Char(36)
  name      String   @db.VarChar(64)
  dynasty   String   @db.VarChar(16) @default("唐")
  bioDesc   String?  @map("bio_desc") @db.MediumText
  bioSimp   String?  @map("bio_simp") @db.MediumText
  createdAt DateTime @default(now()) @map("created_at")

  @@index([name], map: "idx_poet_bios_name")
  @@map("poet_bios")
}

// 意象清单
model Imagery {
  char  String @id @db.Char(4)
  count Int    @default(0)

  @@map("imagery")
}

// 诗-意象关联
model PoemImagery {
  poemId      String  @map("poem_id") @db.Char(36)
  imageryChar String  @map("imagery_char") @db.Char(4)
  lineText    String? @map("line_text") @db.VarChar(500)

  poem Poem @relation(fields: [poemId], references: [id], onDelete: Cascade, map: "fk_pi_poem")

  @@id([poemId, imageryChar])
  @@index([imageryChar], map: "idx_pi_char")
  @@map("poem_imagery")
}

// 意象共现边
model ImageryCooccurrence {
  sourceChar String @map("source_char") @db.Char(4)
  targetChar String @map("target_char") @db.Char(4)
  weight     Int

  @@id([sourceChar, targetChar])
  @@map("imagery_cooccurrence")
}

// RAG 文本切片（poem 向量 ref_id=poem_id；bio 向量 ref_id=poet_bios.id）
model Chunk {
  id        BigInt   @id @default(autoincrement())
  poemId    String?  @map("poem_id") @db.Char(36)
  refId     String?  @map("ref_id") @db.VarChar(64)
  chunkType String   @map("chunk_type") @db.VarChar(16)
  text      String   @db.MediumText
  embedding String?  @db.LongText
  createdAt DateTime @default(now()) @map("created_at")

  poem Poem? @relation(fields: [poemId], references: [id], onDelete: Cascade, map: "fk_chunks_poem")

  @@unique([chunkType, refId], map: "uk_chunks_ref")
  @@index([poemId], map: "idx_chunks_poem")
  @@index([chunkType], map: "idx_chunks_type")
  @@map("chunks")
}

// 注解查询日志
model AnnotationLog {
  id              BigInt   @id @default(autoincrement())
  userQuery       String?  @map("user_query") @db.Text
  poemId          String?  @map("poem_id") @db.Char(36)
  retrievedChunks Json?    @map("retrieved_chunks")
  answer          String?  @db.MediumText
  model           String?  @db.VarChar(32)
  latencyMs       Int?     @map("latency_ms")
  createdAt       DateTime @default(now()) @map("created_at")

  @@map("annotation_logs")
}

// 用户表（鉴权）
model User {
  id                String    @id @default(uuid()) @db.Char(36)
  email             String    @unique @db.VarChar(255)
  // 登录账号：注册时由邮箱前缀自动生成，可与邮箱任选其一登录
  username          String?   @unique @db.VarChar(32)
  name              String?   @db.VarChar(64)
  passwordHash      String    @map("password_hash") @db.VarChar(255)
  role              String    @default("user") @db.VarChar(16)
  status            String    @default("active") @db.VarChar(16)
  avatar            String?   @db.Text
  // 学段：primary 小学 / junior 初中 / senior 高中 / college 大学 / adult 成人，决定闯关与测验的题源与难度
  stage             String    @default("junior") @db.VarChar(16)
  // 学习方向：exam 应试巩固 / taste 兴趣赏析 / create 创作提升
  goal              String    @default("exam") @db.VarChar(16)
  // 是否已完成「定方向」引导（false 时工作台弹出方向选择）
  onboarded         Boolean   @default(false)
  // 密码最后修改时间：JWT 会话签发时间早于该值即视为失效（改密/重置后强制重新登录）
  passwordChangedAt DateTime? @map("password_changed_at")
  createdAt         DateTime  @default(now()) @map("created_at")

  @@map("users")
}

// 学习社区帖子
model Post {
  id         BigInt   @id @default(autoincrement())
  userId     String   @map("user_id") @db.Char(36)
  title      String   @db.VarChar(255)
  content    String   @db.Text
  category   String   @db.VarChar(16)
  // 先审后发：pending -> approved / rejected，作者可随时置为 withdrawn（终态）
  status     String   @default("pending") @db.VarChar(16)
  flagReason String?  @map("flag_reason") @db.VarChar(255)
  reviewNote String?  @map("review_note") @db.VarChar(255)
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([status, createdAt], map: "idx_posts_status")
  @@index([userId], map: "idx_posts_user")
  @@map("posts")
}

// 帖子审核记录（操作历史）：状态变化全程留痕，帖子被删除后记录仍可追溯，故不设外键
model PostReviewLog {
  id           BigInt   @id @default(autoincrement())
  postId       BigInt   @map("post_id")
  postTitle    String   @map("post_title") @db.VarChar(255)
  action       String   @db.VarChar(16)
  fromStatus   String?  @map("from_status") @db.VarChar(16)
  toStatus     String?  @map("to_status") @db.VarChar(16)
  operatorId   String?  @map("operator_id") @db.Char(36)
  operatorName String   @default("系统") @map("operator_name") @db.VarChar(64)
  actorRole    String   @default("system") @map("actor_role") @db.VarChar(16)
  note         String?  @db.VarChar(255)
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([postId], map: "idx_prl_post")
  @@index([createdAt], map: "idx_prl_created")
  @@map("post_review_logs")
}

// 帖子评论（parentId 支持楼中楼回复）
model Comment {
  id        BigInt   @id @default(autoincrement())
  postId    BigInt   @map("post_id")
  userId    String   @map("user_id") @db.Char(36)
  parentId  BigInt?  @map("parent_id")
  content   String   @db.Text
  createdAt DateTime @default(now()) @map("created_at")

  @@index([postId], map: "idx_comments_post")
  @@map("comments")
}

// 帖子点赞
model PostLike {
  id        BigInt   @id @default(autoincrement())
  postId    BigInt   @map("post_id")
  userId    String   @map("user_id") @db.Char(36)
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([postId, userId], map: "uk_post_like")
  @@map("post_likes")
}

// 意见反馈
model Feedback {
  id        BigInt   @id @default(autoincrement())
  userId    String   @map("user_id") @db.Char(36)
  type      String   @db.VarChar(16)
  content   String   @db.Text
  contact   String?  @db.VarChar(64)
  reply     String?  @db.Text
  status    String   @default("open") @db.VarChar(16)
  createdAt DateTime @default(now()) @map("created_at")

  @@index([status, createdAt], map: "idx_feedback_status")
  @@map("feedbacks")
}

// 收藏
model Favorite {
  id        BigInt   @id @default(autoincrement())
  userId    String   @map("user_id") @db.Char(36)
  poemId    String   @map("poem_id") @db.Char(36)
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([userId, poemId], map: "uk_user_poem")
  @@map("favorites")
}

// 学习记录
model History {
  id         BigInt   @id @default(autoincrement())
  userId     String   @map("user_id") @db.Char(36)
  actionType String   @map("action_type") @db.VarChar(24)
  targetId   String?  @map("target_id") @db.VarChar(64)
  title      String?  @db.VarChar(255)
  detail     String?  @db.VarChar(500)
  isRead     Boolean  @default(false) @map("is_read")
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([userId, createdAt], map: "idx_hist_user")
  @@map("histories")
}

// 诗人互提关系（边权重 = 互提次数）
model PoetRelation {
  source  String  @map("source") @db.VarChar(64)
  target  String  @map("target") @db.VarChar(64)
  weight  Int     @default(1)

  @@id([source, target])
  @@map("poet_relations")
}

// 风格迁移创作
model Creation {
  id         BigInt   @id @default(autoincrement())
  userId     String   @map("user_id") @db.Char(36)
  style      String   @db.VarChar(24)
  inputText  String   @map("input_text") @db.Text
  outputText String   @map("output_text") @db.Text
  model      String?  @db.VarChar(32)
  // 旧字段：是否为公开作品，保留用于兼容；分享审核通过时同步为 true
  isPublic   Boolean  @default(false) @map("is_public")
  // 广场分享审核：private / pending / approved / rejected / withdrawn
  shareStatus     String    @default("private") @map("share_status") @db.VarChar(16)
  shareFlagReason String?   @map("share_flag_reason") @db.VarChar(255)
  shareReviewNote String?   @map("share_review_note") @db.VarChar(255)
  sharedAt        DateTime? @map("shared_at")
  reviewedAt      DateTime? @map("reviewed_at")
  createdAt  DateTime @default(now()) @map("created_at")

  likes CreationLike[]

  @@index([userId, createdAt], map: "idx_creation_user")
  @@index([isPublic, createdAt], map: "idx_creation_public")
  @@index([shareStatus, createdAt], map: "idx_creation_share")
  @@map("creations")
}

// 作品广场分享审核记录：与帖子审核同样全程留痕，作品删除后仍可追溯
model CreationReviewLog {
  id            BigInt   @id @default(autoincrement())
  creationId    BigInt   @map("creation_id")
  creationTitle String   @map("creation_title") @db.VarChar(255)
  action        String   @db.VarChar(16)
  fromStatus    String?  @map("from_status") @db.VarChar(16)
  toStatus      String?  @map("to_status") @db.VarChar(16)
  operatorId    String?  @map("operator_id") @db.Char(36)
  operatorName  String   @default("系统") @map("operator_name") @db.VarChar(64)
  actorRole     String   @default("system") @map("actor_role") @db.VarChar(16)
  note          String?  @db.VarChar(255)
  createdAt     DateTime @default(now()) @map("created_at")

  @@index([creationId], map: "idx_crl_creation")
  @@index([createdAt], map: "idx_crl_created")
  @@map("creation_review_logs")
}

// 创作点赞（一人一赞，可取消）
model CreationLike {
  id         BigInt   @id @default(autoincrement())
  creationId BigInt   @map("creation_id")
  userId     String   @map("user_id") @db.Char(36)
  createdAt  DateTime @default(now()) @map("created_at")

  creation Creation @relation(fields: [creationId], references: [id], onDelete: Cascade)

  @@unique([creationId, userId], map: "uk_creation_like")
  @@index([userId], map: "idx_creation_like_user")
  @@map("creation_likes")
}

// 诗词笔记
model Note {
  id        BigInt   @id @default(autoincrement())
  userId    String   @map("user_id") @db.Char(36)
  poemId    String?  @map("poem_id") @db.Char(36)
  title     String?  @db.VarChar(255)
  content   String   @db.Text
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId, createdAt], map: "idx_note_user")
  @@map("notes")
}

// 邮箱验证码（注册验证 / 找回密码共用，只存哈希、一次性消费）
model EmailCode {
  id         BigInt    @id @default(autoincrement())
  email      String    @db.VarChar(255)
  codeHash   String    @map("code_hash") @db.VarChar(255)
  purpose    String    @db.VarChar(16)
  attempts   Int       @default(0)
  expiresAt  DateTime  @map("expires_at")
  consumedAt DateTime? @map("consumed_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  @@index([email, purpose, createdAt], map: "idx_email_code")
  @@map("email_codes")
}

// 测验记录（选择/填空/鉴赏）
model QuizRecord {
  id         BigInt   @id @default(autoincrement())
  userId     String   @map("user_id") @db.Char(36)
  quizType   String   @map("quiz_type") @db.VarChar(16)
  difficulty String   @db.VarChar(8)
  poemId     String?  @map("poem_id") @db.Char(36)
  question   String   @db.VarChar(500)
  options    Json?
  answer     String   @db.VarChar(500)
  userAnswer String?  @map("user_answer") @db.VarChar(500)
  score      Int?
  feedback   String?  @db.Text
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([userId, createdAt], map: "idx_quiz_user")
  @@map("quiz_records")
}

// AI 产物（文生图 / 以图搜诗）：把生成结果落库，供「我的创作」回溯
model AiCreation {
  id        String   @id @default(uuid()) @db.Char(36)
  userId    String   @map("user_id") @db.Char(36)
  kind      String   @db.VarChar(16)
  prompt    String   @db.Text
  imageUrl  String?  @map("image_url") @db.Text
  result    Json?
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId, createdAt], map: "idx_ai_creation_user")
  @@map("ai_creations")
}

// 飞花令对战记录
model FeihuaRecord {
  id        BigInt   @id @default(autoincrement())
  userId    String   @map("user_id") @db.Char(36)
  char      String   @db.VarChar(4)
  result    String   @db.VarChar(8) // win | lose
  rounds    Int      @default(0)
  userLines Int      @default(0) @map("user_lines")
  aiLines   Int      @default(0) @map("ai_lines")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId, createdAt], map: "idx_feihua_user")
  @@map("feihua_records")
}

// 用户通知：反馈回复、帖子/作品审核结果
model Notification {
  id        BigInt   @id @default(autoincrement())
  userId    String   @map("user_id") @db.Char(36)
  type      String   @db.VarChar(32) // feedback_reply | post_approved | post_rejected | share_approved | share_rejected | share_takedown
  title     String   @db.VarChar(255)
  body      String   @db.Text
  link      String?  @db.VarChar(500) // 跳转链接（可选）
  read      Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId, read, createdAt], map: "idx_notif_user")
  @@map("notifications")
}
