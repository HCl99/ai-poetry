# ============================================================
# 墨韵诗心 · 环境变量模板
# 用法：复制本文件为 .env 并填入真实值；.env 已被 .gitignore 忽略
# cp .env.example .env
# ============================================================

# ---- MySQL 数据库连接 ----
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password
MYSQL_DATABASE=ai_poetry

# ---- Prisma 数据库连接串 ----
# 注意：密码中的 @ 需 URL 编码为 %40，# 编码为 %23
DATABASE_URL=mysql://root:your_mysql_password@127.0.0.1:3306/ai_poetry

# ---- 智谱 AI（GLM）大模型 ----
# 申请地址：https://open.bigmodel.cn/
ZHIPUAI_API_KEY=your_zhipuai_api_key
ZHIPUAI_BASE_URL=https://open.bigmodel.cn/api/paas/v4

# ---- 本地语义向量服务（BGE-small-zh，由 scripts/embed_server.py 启动）----
# 没有 Python 环境时可设为 off：不走向量检索，自动降级为 BM25 关键词匹配
EMBED_SERVER_URL=http://127.0.0.1:8100
# EMBED_SERVER_URL=off

# ---- 本地语音微服务（由 scripts/asr_server.py / scripts/tts_server.py 启动）----
# 识别：faster-whisper；合成：edge-tts 神经音色（有感情朗读）
ASR_BASE_URL=http://127.0.0.1:8101
TTS_BASE_URL=http://127.0.0.1:8102

# ---- NextAuth 鉴权 ----
# 生产环境请用 `openssl rand -base64 32` 生成随机密钥
AUTH_SECRET=please_generate_a_random_secret
AUTH_URL=http://localhost:3000
AUTH_TRUST_HOST=true

# ---- QQ 邮箱 SMTP（注册验证码 / 找回密码）----
# 申请方式：QQ 邮箱 → 设置 → 账号 → 开启 SMTP 服务 → 生成授权码（不是登录密码）
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_USER=your_account@qq.com
SMTP_PASS=your_smtp_authorization_code
# 可选：发件人显示名，留空则使用「墨韵诗心 <SMTP_USER>」
SMTP_FROM=

# ---- MCP Server 外部访问密钥 ----
# 供外部 Agent（Claude Desktop / Cursor）通过 Authorization: Bearer <KEY> 调用 /api/mcp
# 生成：openssl rand -hex 24；留空则仅允许站内登录会话调用
MCP_API_KEY=
